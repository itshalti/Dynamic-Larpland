pragma Singleton
// Compositor integration. Hyprland gets focused-monitor tracking and generated keybinds;
// on any other compositor these degrade to "all screens" and manual binding via IPC.
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import QtQuick
import qs.services

Singleton {
    id: root

    readonly property bool isHyprland: !!Quickshell.env("HYPRLAND_INSTANCE_SIGNATURE")
    readonly property string appId: "dynamic-larpland"
    readonly property var actions: ["launcher", "toggle", "player", "calendar"]

    // Name of the focused output, or "" when unknown (then every screen reacts).
    readonly property string focusedScreen: isHyprland ? (Hyprland.focusedMonitor?.name ?? "") : ""

    readonly property string home: Quickshell.env("HOME") ?? ""
    readonly property string bindsPath: Config.dir + "/binds.lua"
    // bindsPath relative to $HOME (for display and for the include line).
    readonly property string bindsPathInHome: home && bindsPath.startsWith(home + "/") ? bindsPath.slice(home.length) : ""
    readonly property string bindsPathDisplay: bindsPathInHome ? "~" + bindsPathInHome : bindsPath

    // Line to include from the Hyprland Lua config so the generated binds are loaded.
    readonly property string includeLine: bindsPathInHome ? `pcall(dofile, os.getenv("HOME") .. "${bindsPathInHome}")` : `pcall(dofile, "${bindsPath}")`

    function ipcCommand(action: string): string {
        return `qs -p ${Quickshell.shellDir} ipc call island ${action}`;
    }

    function setKeybind(action: string, keys: string): void {
        Config.keybinds[action] = keys;
        writeBinds();
    }

    // Regenerates binds.lua from the config and reloads Hyprland if it changed.
    function writeBinds(): void {
        if (!isHyprland || !Config.dirsReady)
            return;
        let lua = "-- Generated by Dynamic-Larpland settings. Edit the keybinds there, not here.\n";
        for (const action of actions) {
            const keys = Config.keybinds[action];
            if (keys)
                lua += `hl.bind(${JSON.stringify(keys)}, hl.dsp.global(${JSON.stringify(appId + ":" + action)}))\n`;
        }
        bindsFile.reload();
        if (bindsFile.text() === lua)
            return;
        bindsFile.setText(lua);
    }

    Connections {
        target: Config

        function onLoaded(): void {
            root.writeBinds();
        }

        function onDirsReadyChanged(): void {
            root.writeBinds();
        }
    }

    FileView {
        id: bindsFile
        path: root.bindsPath
        blockLoading: true
        printErrors: false
        onSaved: hyprReload.running = true
    }

    Process {
        id: hyprReload
        command: ["hyprctl", "reload", "config-only"]
    }
}
